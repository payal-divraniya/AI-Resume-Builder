# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (use your own local or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/ai-resume-builder

# Generate a long random secret; never commit the real value
JWT_SECRET=replace_with_a_long_random_secret

# Groq AI provider; keep this key only in the backend environment
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated frontend origins for production, e.g. https://your-app.example
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
